---
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/global.css"

const pageTitle = "Ahoy-hoy!"
---

<BaseLayout pageTitle={pageTitle}>
	<h1>{pageTitle}</h1>
	<p>
		I'm an economist and data scientist who lives in Toronto.
	</p>
	<p>
		My technical interests, broadly speaking, are in econometrics and computational modeling.
		I primarily use Python and am currently learning Julia.
	</p>
	<p>
		Besides programming, I enjoy cooking and learning new languages.
		I can speak Spanish, French, and Indonesian.
	</p>
	<p>
		You can see some of my work on <a href="https://github.com/Firanxa">GitHub</a>.
	</p>
</BaseLayout>
